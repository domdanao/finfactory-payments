{
  "name": "@domdanao/finfactory-payments",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript SDK for the FinFactory Payments Merchant API: payment intents, refunds, disputes and webhooks. Zero dependencies; Node.js, Deno, Bun and Cloudflare Workers.",
  "keywords": [
    "finfactory",
    "payments",
    "qrph",
    "gcash",
    "philippines",
    "checkout",
    "webhooks",
    "sdk"
  ],
  "license": "MIT",
  "author": "Dominick Danao",
  "homepage": "https://github.com/domdanao/finfactory-payments/tree/main/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domdanao/finfactory-payments.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/domdanao/finfactory-payments/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
